import { useState } from 'react';
import { TeamCapSummary, PlayerContract } from '@/types/sleeper';

interface RosterDetailProps {
  team: TeamCapSummary;
  onEditPlayerSalary: (playerId: string, currentSalary: number, name: string) => void;
}

const POSITIONS = ['QB', 'RB', 'WR', 'TE', 'K', 'DEF'];

export function RosterDetail({ team, onEditPlayerSalary }: RosterDetailProps) {
  const [filterPos, setFilterPos] = useState<string>('ALL');

  const groupedContracts = POSITIONS.reduce((acc, pos) => {
    acc[pos] = team.contracts.filter((c) => (c.player.position || 'OTHER') === pos);
    return acc;
  }, {} as Record<string, PlayerContract[]>);

  const displayedContracts =
    filterPos === 'ALL'
      ? team.contracts
      : team.contracts.filter((c) => c.player.position === filterPos);

  return (
    <div className="bg-slate-900 border border-slate-800 rounded-xl p-6">
      <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center pb-6 border-b border-slate-800 gap-4">
        <div>
          <h2 className="text-xl font-bold text-white flex items-center gap-2">
            {team.teamName} <span className="text-sm font-normal text-slate-400">Roster Breakdown</span>
          </h2>
          <p className="text-xs text-slate-400 mt-0.5">Manager: {team.managerName}</p>
        </div>

        {/* Position Filter Tabs */}
        <div className="flex gap-1 bg-slate-950 p-1 rounded-lg border border-slate-800 overflow-x-auto max-w-full">
          {['ALL', ...POSITIONS].map((pos) => (
            <button
              key={pos}
              onClick={() => setFilterPos(pos)}
              className={`px-3 py-1 text-xs font-semibold rounded-md transition-colors ${
                filterPos === pos
                  ? 'bg-indigo-600 text-white shadow-sm'
                  : 'text-slate-400 hover:text-slate-200'
              }`}
            >
              {pos}
            </button>
          ))}
        </div>
      </div>

      {/* Roster Table */}
      <div className="overflow-x-auto mt-4">
        <table className="w-full text-left border-collapse">
          <thead>
            <tr className="border-b border-slate-800 text-slate-400 text-xs uppercase tracking-wider font-semibold">
              <th className="py-3 px-4">Player</th>
              <th className="py-3 px-4">Position</th>
              <th className="py-3 px-4">NFL Team</th>
              <th className="py-3 px-4">Acquired Via</th>
              <th className="py-3 px-4">Status</th>
              <th className="py-3 px-4 text-right">Salary</th>
              <th className="py-3 px-4 text-center">Actions</th>
            </tr>
          </thead>
          <tbody className="divide-y divide-slate-800/60 text-sm">
            {displayedContracts.map(({ playerId, player, salary, acquiredVia, status }) => {
              const fullName = player.full_name || `${player.first_name || ''} ${player.last_name || ''}`.trim() || 'Unknown Player';

              return (
                <tr key={playerId} className="hover:bg-slate-800/40 transition-colors">
                  <td className="py-3.5 px-4 font-medium text-slate-200 flex items-center gap-3">
                    <div className="w-8 h-8 rounded-full bg-slate-800 border border-slate-700 flex items-center justify-center font-bold text-xs text-indigo-400">
                      {player.position || 'N/A'}
                    </div>
                    <div>
                      <div className="font-semibold">{fullName}</div>
                      <div className="text-xs text-slate-500">{player.team || 'FA'}</div>
                    </div>
                  </td>
                  <td className="py-3.5 px-4">
                    <span className="px-2 py-0.5 rounded text-xs font-semibold bg-slate-800 border border-slate-700 text-slate-300">
                      {player.position || 'N/A'}
                    </span>
                  </td>
                  <td className="py-3.5 px-4 text-slate-400">{player.team || 'FA'}</td>
                  <td className="py-3.5 px-4">
                    <span
                      className={`text-xs px-2 py-0.5 rounded font-medium border ${
                        acquiredVia === 'Waiver'
                          ? 'border-cyan-500/30 bg-cyan-500/10 text-cyan-400'
                          : acquiredVia === 'Manual Override'
                          ? 'border-purple-500/30 bg-purple-500/10 text-purple-300'
                          : 'border-slate-700 bg-slate-800 text-slate-400'
                      }`}
                    >
                      {acquiredVia}
                    </span>
                  </td>
                  <td className="py-3.5 px-4">
                    <span
                      className={`text-xs font-semibold ${
                        status === 'Active' ? 'text-emerald-400' : 'text-amber-400'
                      }`}
                    >
                      {status}
                    </span>
                  </td>
                  <td className="py-3.5 px-4 text-right font-mono font-bold text-slate-100">
                    ${salary.toFixed(2)}
                  </td>
                  <td className="py-3.5 px-4 text-center">
                    <button
                      onClick={() => onEditPlayerSalary(playerId, salary, fullName)}
                      className="text-xs bg-slate-800 hover:bg-slate-700 text-indigo-400 hover:text-indigo-300 border border-slate-700 px-2.5 py-1 rounded transition-colors"
                    >
                      Edit
                    </button>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  );
}
